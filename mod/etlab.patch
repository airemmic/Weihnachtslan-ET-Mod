+	{
+		return qtrue;
+	}
+	return target->s.eType == ET_MISSILE &&
+	       ((target->methodOfDeath == MOD_LANDMINE && (target->s.effect1Time == 1 || target->s.effect1Time == 2)) ||
+	        (target->methodOfDeath == MOD_DYNAMITE && target->s.effect1Time));
