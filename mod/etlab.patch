+/**
+ * @brief Counts a Christmas award event; like the original stats only while the match is running.
+ */
+void G_ETLabAwardCount(gentity_t *ent, etlabStat_t stat)
+{
+	if (g_gamestate.integer != GS_PLAYING || !ent || !ent->client)
+	{
+		return;
+	}
+	ent->client->sess.etlabStats[stat]++;
+}
+
+/**
+ * @brief Award score of a player; team kills, headshots and knife kills come from the original stats.
+ */
+int G_ETLabAwardValue(gclient_t *cl, int award)
+{
+	int i, value = 0;
+
+	switch (award)
+	{
+	case ETLAB_AWARD_ANGEL:
+		return cl->sess.etlabStats[ETLAB_STAT_REVIVES];
+	case ETLAB_AWARD_HELPER:
+		return cl->sess.etlabStats[ETLAB_STAT_DEFUSES];
+	case ETLAB_AWARD_STAR:
+		return cl->sess.etlabStats[ETLAB_STAT_MINES_SPOTTED];
+	case ETLAB_AWARD_KRAMPUS:
+		return cl->sess.team_kills;
+	case ETLAB_AWARD_GRINCH:
+		return cl->sess.etlabStats[ETLAB_STAT_DESTRUCTIONS];
+	case ETLAB_AWARD_FIRECRACKER:
+		return cl->sess.etlabStats[ETLAB_STAT_GRENADE_MINES];
+	case ETLAB_AWARD_NUTCRACKER:
+		for (i = 0; i < WS_MAX; i++)
+		{
+			value += cl->sess.aWeaponStats[i].headshots;
+		}
+		return value;
+	case ETLAB_AWARD_SILENTNIGHT:
+		return cl->sess.aWeaponStats[WS_KNIFE].kills + cl->sess.aWeaponStats[WS_KNIFE_KBAR].kills;
+	case ETLAB_AWARD_WORKSHOPELF:
+		return cl->sess.etlabStats[ETLAB_STAT_CONSTRUCTIONS];
+	case ETLAB_AWARD_SECRETSANTA:
+		return cl->sess.etlabStats[ETLAB_STAT_PACKS];
+	default:
+		return 0;
+	}
+}
+
+/**
+ * @brief Appends "clientNum value team" per Christmas award to the endgame configstring and announces the winners.
+ * Only Axis/Allies players with at least one point qualify. Ties go to the higher-ranked player;
+ * Krampus breaks ties by team damage like the original team kill award.
+ * The chat lines are composed by cgame (etlabawards/etlabaward) so they follow each player's language.
+ */
+void G_ETLabBuildAwards(char *buffer, int size)
+{
+	qboolean header = qfalse;
+	int      award, i;
+
+	if (!g_etlabAwards.integer)
+	{
+		return;
+	}
+
+	for (award = 0; award < ETLAB_AWARD_COUNT; award++)
+	{
+		gclient_t *best         = NULL;
+		int       bestClientNum = -1, bestValue = 0;
+
+		for (i = 0; i < level.numConnectedClients; i++)
+		{
+			gclient_t *cl = &level.clients[level.sortedClients[i]];
+			int       value;
+
+			if (cl->sess.sessionTeam != TEAM_AXIS && cl->sess.sessionTeam != TEAM_ALLIES)
+			{
+				continue;
+			}
+
+			value = G_ETLabAwardValue(cl, award);
+			if (value > bestValue || (best && value == bestValue && award == ETLAB_AWARD_KRAMPUS && cl->sess.team_damage_given > best->sess.team_damage_given))
+			{
+				best          = cl;
+				bestClientNum = level.sortedClients[i];
+				bestValue     = value;
+			}
+		}
+
+		if (!best)
+		{
+			Q_strcat(buffer, size, "-1 0 0 ");
+			continue;
+		}
+
+		Q_strcat(buffer, size, va("%i %i %i ", bestClientNum, bestValue, best->sess.sessionTeam));
+		if (!header)
+		{
+			trap_SendServerCommand(-1, "etlabawards");
+			header = qtrue;
+		}
+		trap_SendServerCommand(-1, va("etlabaward %i %i %i \"%s\"", award, bestClientNum, bestValue, best->pers.netname));
+	}
+}
