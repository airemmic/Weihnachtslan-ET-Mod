+const etlabModifierInfo_t etlabModifiers[ETLAB_MOD_COUNT] =
+{
+	{ "none",          "No modifier",        "Regular rules.",                                            qfalse },
+	{ "doublexp",      "Double XP",          "All experience points are doubled.",                        qfalse },
+	{ "fastspawn",     "Fast Reinforcements", "Reinforcement time is halved.",                            qfalse },
+	{ "longdyno",      "Long Fuse",          "Dynamite explodes after 45 seconds instead of 30.",         qfalse },
+	{ "quickspot",     "Quick Spotting",     "Binoculars spot enemy landmines twice as fast.",            qfalse },
+	{ "medicshortage", "Medic Shortage",     "At most two medics per team, slower medic charge.",         qfalse },
+	{ "engineerfest",  "Engineer Fest",      "Double landmine limit, faster engineer charge.",            qfalse },
+	{ "heavyfree",     "Heavy Weapons Free", "No team limits for heavy weapons.",                         qfalse },
+	{ "lowammo",       "Low Ammo",           "Spawn with half of the reserve ammunition.",                qfalse },
+	{ "suddendeath",   "Sudden Death",       "No reinforcements during the final two minutes.",           qfalse },
+	{ "classrotation", "Class Rotation",     "Every spawn needs a different class than the last one.",    qfalse },
+	{ "lowgravity",    "Low Gravity",        "Gravity is halved.",                                        qtrue  },
+	{ "sidearms",      "Sidearms Only",      "No primary weapons and no hand grenades.",                  qtrue  },
+	{ "iceskating",    "Ice Skating",        "Faster movement, double knockback.",                        qtrue  },
+	{ "grenaderain",   "Grenade Rain",       "Hand grenades are refilled every 20 seconds.",              qtrue  },
+	{ "headshots",     "Headshots Only",     "Only headshots damage players.",                            qtrue  },
+	{ "vampire",       "Vampire",            "Each kill restores 20 health.",                             qtrue  },
+};
+
+/**
+ * @brief Modifier index for a name; ETLAB_MOD_NONE for "none", -1 for unknown names.
+ */
+int BG_ETLabModifierByName(const char *name)
+{
+	int i;
+
+	if (!name || !name[0])
+	{
+		return -1;
+	}
+	for (i = 0; i < ETLAB_MOD_COUNT; i++)
+	{
+		if (!Q_stricmp(name, etlabModifiers[i].name))
+		{
+			return i;
+		}
+	}
+	return -1;
+}
+
+/**
+ * @brief Whether a modifier is part of a pool string ("all" or names separated by spaces/commas/semicolons).
+ */
+qboolean BG_ETLabModifierInPool(const char *pool, int index)
+{
+	char token[64];
+	int  length;
+
+	if (index <= ETLAB_MOD_NONE || index >= ETLAB_MOD_COUNT || !pool)
+	{
+		return qfalse;
+	}
+	while (*pool)
+	{
+		while (*pool == ' ' || *pool == ',' || *pool == ';' || *pool == '\t')
+		{
+			pool++;
+		}
+		length = 0;
+		while (*pool && *pool != ' ' && *pool != ',' && *pool != ';' && *pool != '\t')
+		{
+			if (length < (int)sizeof(token) - 1)
+			{
+				token[length++] = *pool;
+			}
+			pool++;
+		}
+		token[length] = '\0';
+		if (!length)
+		{
+			continue;
+		}
+		if (!Q_stricmp(token, "all") || !Q_stricmp(token, etlabModifiers[index].name))
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/**
+ * @brief Number of pool members; fills indexes when a buffer of ETLAB_MOD_COUNT entries is given.
+ */
+int BG_ETLabModifierPoolList(const char *pool, int *indexes)
+{
+	int i, count = 0;
+
+	for (i = ETLAB_MOD_NONE + 1; i < ETLAB_MOD_COUNT; i++)
+	{
+		if (BG_ETLabModifierInPool(pool, i))
+		{
+			if (indexes)
+			{
+				indexes[count] = i;
+			}
+			count++;
+		}
+	}
+	return count;
+}
+
+const etlabAwardInfo_t etlabAwards[ETLAB_AWARD_COUNT] =
+{
+	{ "Christmas Angel",        "most revives"                           },
+	{ "Santa's Little Helper",  "most dynamite and landmines defused"    },
+	{ "Star of Bethlehem",      "most landmines spotted"                 },
+	{ "Krampus",                "most team kills"                        },
+	{ "Grinch",                 "most enemy structures destroyed"        },
+	{ "New Year's Firecracker", "most hidden mines blown up by grenade"  },
+	{ "Nutcracker",             "most headshots"                         },
+	{ "Silent Night",           "most knife kills"                       },
+	{ "Workshop Elf",           "most constructions and repairs"         },
+	{ "Secret Santa",           "most packs handed to teammates"         },
+};
