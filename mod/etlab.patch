+ * along with ET: Legacy. If not, see <http://www.gnu.org/licenses/>.
+ */
+/**
+ * @file cg_etlab.c
+ * @brief ETLab round modifiers on the client (configstring parsing and HUD note) and Christmas award chat lines.
+ */
+
+#include "cg_local.h"
+
+void CG_ETLabModifierChanged(void)
+{
+	const char *info = CG_ConfigString(CS_ETLAB_MODIFIER);
+	int        index = 0, end = 0;
+
+	if (info && info[0])
+	{
+		sscanf(info, "%i %i", &index, &end);
+	}
+	cgs.etlabModifier    = (index > ETLAB_MOD_NONE && index < ETLAB_MOD_COUNT) ? index : ETLAB_MOD_NONE;
+	cgs.etlabModifierEnd = end;
+}
+
+qboolean CG_ETLabModifierActive(int index)
+{
+	return cgs.etlabModifier == index && index != ETLAB_MOD_NONE;
+}
+
+/**
+ * @brief Reinforcement time as the server applies it.
+ */
+int CG_ETLabLimboTime(int base)
+{
+	if (CG_ETLabModifierActive(ETLAB_MOD_FASTSPAWN))
+	{
+		return base >= 2000 ? base / 2 : base;
+	}
+	return base;
+}
+
+/**
+ * @brief Small note below the top of the screen while a modifier is active.
+ */
+void CG_ETLabDrawModifier(void)
+{
+	const char *text;
+	float      scale = 0.19f;
+	vec4_t     color = { 1.f, 0.85f, 0.4f, 0.9f };
+	int        width;
+
+	if (cgs.etlabModifier == ETLAB_MOD_NONE || cg.demoPlayback)
+	{
+		return;
+	}
+	if (cgs.etlabModifierEnd > 0 && cg.time < cgs.etlabModifierEnd)
+	{
+		int seconds = (cgs.etlabModifierEnd - cg.time + 999) / 1000;
+
+		text = va("%s (%i:%02i)", etlabModifiers[cgs.etlabModifier].title, seconds / 60, seconds % 60);
+	}
+	else
+	{
+		text = etlabModifiers[cgs.etlabModifier].title;
+	}
+	width = CG_Text_Width_Ext(text, scale, 0, &cgs.media.limboFont2);
+	CG_Text_Paint_Ext(Ccg_WideX(SCREEN_WIDTH) / 2.f - width / 2.f, 54, scale, scale, color, text, 0, 0, ITEM_TEXTSTYLE_SHADOWED, &cgs.media.limboFont2);
+}
+
+/**
+ * @brief Christmas award chat line in the player's language.
+ * Server commands: "etlabawards" (header) and "etlabaward <award> <clientNum> <value> <name>".
+ */
+void CG_ETLabAwardChat(qboolean header)
+{
+	char       name[MAX_NAME_LENGTH];
+	const char *line;
+	int        award, value;
+
+	if (cg_teamChatsOnly.integer && cgs.clientinfo[cg.clientNum].team != TEAM_SPECTATOR)
+	{
+		return;
+	}
+
+	if (header)
+	{
+		line = va("^3%s", CG_TranslateString("*** Christmas Awards ***"));
+	}
+	else
+	{
+		award = Q_atoi(CG_Argv(1));
+		value = Q_atoi(CG_Argv(3));
+		Q_strncpyz(name, CG_Argv(4), sizeof(name));
+		if (award < 0 || award >= ETLAB_AWARD_COUNT)
+		{
+			return;
+		}
+		line = va("^3%s^7 (%s): %s^7 - %i", CG_TranslateString(etlabAwards[award].title), CG_TranslateString(etlabAwards[award].description), name, value);
+	}
+
+	CG_AddToTeamChat(line, -1);
+	CG_Printf("%s\n", line);
+	CG_WriteToLog("%s\n", line);
+}
