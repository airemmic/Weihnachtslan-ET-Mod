+/**
+ * @file g_etlab.c
+ * @brief ETLab round modifiers (selection, lifetime and server-side rule hooks) and Christmas awards.
+ *
+ * g_etlabModifierPool lists the modifiers that may be chosen ("all" or names).
+ * g_etlabModifierMode: 0 off, 1 random per map, 2 vote only, 3 random with vote override.
+ * Short-lived ("gaudi") modifiers end g_etlabModifierMinutes after the match starts.
+ * g_etlabAwards 1 adds the Christmas awards to the debriefing and announces them in chat.
+ */
+
+#include "g_local.h"
+
+#define ETLAB_GAUDI_DEFAULT_MINUTES 5
+#define ETLAB_SUDDEN_DEATH_WINDOW   120000
+#define ETLAB_GRENADE_INTERVAL      20000
+#define ETLAB_VAMPIRE_HEAL          20
+
+// g_vote.c helpers without a public prototype
+qboolean G_voteDescription(gentity_t *ent, qboolean fRefereeCmd, unsigned int cmd);
+void G_voteCurrentSetting(gentity_t *ent, const char *cmd, const char *setting);
+// g_cmds.c helper without a public prototype
+qboolean G_IsClassFull(gentity_t *ent, int playerType, team_t team);
+
+static const char *G_ETLabModifierName(int index)
+{
+	return (index > ETLAB_MOD_NONE && index < ETLAB_MOD_COUNT) ? etlabModifiers[index].name : "none";
+}
+
+qboolean G_ETLabModifierActive(int index)
+{
+	return level.etlabModifier == index && index != ETLAB_MOD_NONE;
+}
+
+static qboolean G_ETLabModifierIsGaudi(int index)
+{
+	return index > ETLAB_MOD_NONE && index < ETLAB_MOD_COUNT && etlabModifiers[index].gaudi;
+}
+
+static int G_ETLabGaudiDuration(void)
+{
+	int minutes = g_etlabModifierMinutes.integer > 0 ? g_etlabModifierMinutes.integer : ETLAB_GAUDI_DEFAULT_MINUTES;
+
+	return minutes * 60000;
+}
+
+static void G_ETLabModifierUpdateConfigstring(void)
+{
+	trap_SetConfigstring(CS_ETLAB_MODIFIER, va("%i %i", level.etlabModifier, level.etlabModifierEnd));
+}
+
+/**
+ * @brief Medic/engineer charge times with the modifier factor, mirrored to the client configstring.
+ */
+void G_ETLabApplyChargeTimes(void)
+{
+	float medic    = G_ETLabModifierActive(ETLAB_MOD_MEDICSHORTAGE) ? 1.5f : 1.f;
+	float engineer = G_ETLabModifierActive(ETLAB_MOD_ENGINEERFEST) ? 0.5f : 1.f;
+	char  cs[MAX_INFO_STRING];
+	int   team;
+
+	for (team = 0; team < 2; team++)
+	{
+		level.medicChargeTime[team]    = g_medicChargeTime.integer * level.medicChargeTimeModifier[team] * medic;
+		level.engineerChargeTime[team] = g_engineerChargeTime.integer * level.engineerChargeTimeModifier[team] * engineer;
+	}
+
+	cs[0] = '\0';
+	Info_SetValueForKey(cs, "x0", va("%i", level.soldierChargeTime[0]));
+	Info_SetValueForKey(cs, "a0", va("%i", level.soldierChargeTime[1]));
+	Info_SetValueForKey(cs, "x1", va("%i", level.medicChargeTime[0]));
+	Info_SetValueForKey(cs, "a1", va("%i", level.medicChargeTime[1]));
+	Info_SetValueForKey(cs, "x2", va("%i", level.engineerChargeTime[0]));
+	Info_SetValueForKey(cs, "a2", va("%i", level.engineerChargeTime[1]));
+	Info_SetValueForKey(cs, "x3", va("%i", level.fieldopsChargeTime[0]));
+	Info_SetValueForKey(cs, "a3", va("%i", level.fieldopsChargeTime[1]));
+	Info_SetValueForKey(cs, "x4", va("%i", level.covertopsChargeTime[0]));
+	Info_SetValueForKey(cs, "a4", va("%i", level.covertopsChargeTime[1]));
+	trap_SetConfigstring(CS_CHARGETIMES, cs);
+}
+
+static void G_ETLabModifierAnnounce(gentity_t *ent, int index)
+{
+	int clientNum = ent ? (int)(ent - g_entities) : -1;
+
+	if (index == ETLAB_MOD_NONE)
+	{
+		trap_SendServerCommand(clientNum, "cpm \"^3Round modifier: ^5none\n\"");
+		return;
+	}
+	trap_SendServerCommand(clientNum, va("cpm \"^3Round modifier: ^5%s^7 - %s\n\"", etlabModifiers[index].title, etlabModifiers[index].description));
+	if (G_ETLabModifierIsGaudi(index))
+	{
+		trap_SendServerCommand(clientNum, va("print \"^3Round modifier ^5%s^3 lasts %i minutes after the match starts.\n\"", etlabModifiers[index].title, G_ETLabGaudiDuration() / 60000));
+	}
+}
+
+/**
+ * @brief Activates a modifier for the current map; announce broadcasts the change.
+ */
+void G_ETLabModifierSet(int index, qboolean announce)
+{
+	if (index < ETLAB_MOD_NONE || index >= ETLAB_MOD_COUNT)
+	{
+		index = ETLAB_MOD_NONE;
+	}
+	level.etlabModifier          = index;
+	level.etlabModifierEnd       = 0;
+	level.etlabModifierNextTick  = 0;
+	level.etlabSuddenDeathWarned = qfalse;
+	trap_Cvar_Set("etlab_modifier", G_ETLabModifierName(index));
+	G_ETLabApplyChargeTimes();
+	G_ETLabModifierUpdateConfigstring();
+	G_LogPrintf("ETLAB_MODIFIER: %s\n", G_ETLabModifierName(index));
+	if (announce)
+	{
+		G_ETLabModifierAnnounce(NULL, index);
+	}
+}
+
+/**
+ * @brief Map start: keep the modifier across map_restart, otherwise choose according to the mode.
+ */
+void G_ETLabModifierInit(qboolean restart)
+{
+	int index = ETLAB_MOD_NONE;
+
+	if (g_etlabModifierMode.integer != ETLAB_MODE_OFF)
+	{
+		if (restart)
+		{
+			char saved[64];
+
+			trap_Cvar_VariableStringBuffer("etlab_modifier", saved, sizeof(saved));
+			index = BG_ETLabModifierByName(saved);
+			if (index < 0 || !BG_ETLabModifierInPool(g_etlabModifierPool.string, index))
+			{
+				index = ETLAB_MOD_NONE;
+			}
+		}
+		else if (g_etlabModifierMode.integer == ETLAB_MODE_RANDOM || g_etlabModifierMode.integer == ETLAB_MODE_RANDOM_VOTE)
+		{
+			int pool[ETLAB_MOD_COUNT];
+			int count = BG_ETLabModifierPoolList(g_etlabModifierPool.string, pool);
+
+			if (count > 0)
+			{
+				index = pool[rand() % count];
+			}
+		}
+	}
+	G_ETLabModifierSet(index, qfalse);
+}
+
+/**
+ * @brief Per-frame lifetime handling: start/stop of short modifiers, timed effects, warnings.
+ */
+void G_ETLabModifierFrame(void)
+{
+	int index = level.etlabModifier;
+
+	if (index == ETLAB_MOD_NONE)
+	{
+		return;
+	}
+
+	if (g_gamestate.integer != GS_PLAYING)
+	{
+		return;
+	}
+
+	if (G_ETLabModifierIsGaudi(index))
+	{
+		if (!level.etlabModifierEnd)
+		{
+			level.etlabModifierEnd = level.time + G_ETLabGaudiDuration();
+			G_ETLabModifierUpdateConfigstring();
+			G_ETLabModifierAnnounce(NULL, index);
+		}
+		else if (level.time >= level.etlabModifierEnd)
+		{
+			// Expired for this round only; the saved cvar restores it after a map_restart.
+			level.etlabModifier    = ETLAB_MOD_NONE;
+			level.etlabModifierEnd = 0;
+			G_ETLabApplyChargeTimes();
+			G_ETLabModifierUpdateConfigstring();
+			AP(va("cpm \"^3Round modifier ^5%s^3 has ended. Regular rules again.\n\"", etlabModifiers[index].title));
+			G_LogPrintf("ETLAB_MODIFIER_END: %s\n", etlabModifiers[index].name);
+			return;
+		}
+	}
+
+	if (index == ETLAB_MOD_GRENADERAIN && level.time >= level.etlabModifierNextTick)
+	{
+		int i;
+
+		level.etlabModifierNextTick = level.time + ETLAB_GRENADE_INTERVAL;
+		for (i = 0; i < level.numConnectedClients; i++)
+		{
+			gentity_t        *ent = &g_entities[level.sortedClients[i]];
+			bg_playerclass_t *classInfo;
+			weapon_t         grenade;
+
+			if (!ent->inuse || !ent->client || ent->health <= 0 || (ent->client->ps.pm_flags & PMF_LIMBO) ||
+			    (ent->client->sess.sessionTeam != TEAM_AXIS && ent->client->sess.sessionTeam != TEAM_ALLIES))
+			{
+				continue;
+			}
+			classInfo = BG_GetPlayerClassInfo(ent->client->sess.sessionTeam, ent->client->sess.playerType);
+			grenade   = classInfo->classGrenadeWeapon.weapon;
+			if (grenade && COM_BitCheck(ent->client->ps.weapons, grenade))
+			{
+				// grenades live in the reserve and are moved into the clip one at a time
+				int max  = BG_MaxAmmoForWeapon(grenade, ent->client->sess.skill, ent->client->sess.playerType);
+				int clip = ent->client->ps.ammoclip[GetWeaponTableData(grenade)->clipIndex];
+
+				if (ent->client->ps.ammo[GetWeaponTableData(grenade)->ammoIndex] + clip < max)
+				{
+					ent->client->ps.ammo[GetWeaponTableData(grenade)->ammoIndex] = max - clip;
+				}
+			}
+		}
+	}
+
+	if (index == ETLAB_MOD_SUDDENDEATH && !level.etlabSuddenDeathWarned && G_ETLabRespawnBlocked())
+	{
+		level.etlabSuddenDeathWarned = qtrue;
+		AP("cpm \"^1Sudden Death: ^7no more reinforcements until the round ends!\n\"");
+	}
+}
+
+/**
+ * @brief Tell a newly joined client which modifier is active.
+ */
+void G_ETLabModifierClientBegin(gentity_t *ent)
+{
+	if (level.etlabModifier != ETLAB_MOD_NONE && ent && ent->client && !(ent->r.svFlags & SVF_BOT))
+	{
+		G_ETLabModifierAnnounce(ent, level.etlabModifier);
+	}
+}
+
+int G_ETLabLimboTime(int base)
+{
+	if (G_ETLabModifierActive(ETLAB_MOD_FASTSPAWN))
+	{
+		return base >= 2000 ? base / 2 : base;
+	}
+	return base;
+}
+
+int G_ETLabDynamiteFuse(void)
+{
+	return G_ETLabModifierActive(ETLAB_MOD_LONGDYNO) ? 45000 : 30000;
+}
+
+int G_ETLabTeamMaxLandmines(void)
+{
+	if (G_ETLabModifierActive(ETLAB_MOD_ENGINEERFEST) && team_maxLandmines.integer > 0)
+	{
+		return team_maxLandmines.integer * 2;
+	}
+	return team_maxLandmines.integer;
+}
+
+/**
+ * @brief Sudden Death: reinforcements stop within the final two minutes of a timelimit.
+ */
+qboolean G_ETLabRespawnBlocked(void)
+{
+	int remaining;
+
+	if (!G_ETLabModifierActive(ETLAB_MOD_SUDDENDEATH) || g_gamestate.integer != GS_PLAYING || g_timelimit.value <= 0.f)
+	{
+		return qfalse;
+	}
+	remaining = (int)(g_timelimit.value * 60000) - (level.timeCurrent - level.startTime);
+	return remaining <= ETLAB_SUDDEN_DEATH_WINDOW;
+}
+
+/**
+ * @brief Spawn loadout adjustments after the regular loadout has been assigned.
+ */
+void G_ETLabModifierSpawnWeapons(gclient_t *client)
+{
+	int i;
+
+	if (client->sess.sessionTeam != TEAM_AXIS && client->sess.sessionTeam != TEAM_ALLIES)
+	{
+		return;
+	}
+
+	if (G_ETLabModifierActive(ETLAB_MOD_SIDEARMS))
+	{
+		const int strip = WEAPON_TYPE_SMG | WEAPON_TYPE_RIFLE | WEAPON_TYPE_GRENADE | WEAPON_TYPE_RIFLENADE |
+		                  WEAPON_TYPE_MORTAR | WEAPON_TYPE_MG | WEAPON_TYPE_PANZER | WEAPON_TYPE_BEAM;
+
+		for (i = WP_NONE + 1; i < WP_NUM_WEAPONS; i++)
+		{
+			if (COM_BitCheck(client->ps.weapons, i) && (GetWeaponTableData(i)->type & strip))
+			{
+				COM_BitClear(client->ps.weapons, i);
+			}
+		}
+		if (!COM_BitCheck(client->ps.weapons, client->ps.weapon))
+		{
+			client->ps.weapon = WP_KNIFE;
+			for (i = WP_NONE + 1; i < WP_NUM_WEAPONS; i++)
+			{
+				if (COM_BitCheck(client->ps.weapons, i) && (GetWeaponTableData(i)->type & WEAPON_TYPE_PISTOL))
+				{
+					client->ps.weapon = i;
+					break;
+				}
+			}
+		}
+	}
+
+	if (G_ETLabModifierActive(ETLAB_MOD_LOWAMMO))
+	{
+		// halve the reserve of every weapon except hand grenades, which already come in ones
+		for (i = WP_NONE + 1; i < WP_NUM_WEAPONS; i++)
+		{
+			if (COM_BitCheck(client->ps.weapons, i) && !(GetWeaponTableData(i)->type & WEAPON_TYPE_GRENADE) &&
+			    GetWeaponTableData(i)->ammoIndex == i)
+			{
+				client->ps.ammo[i] /= 2;
+			}
+		}
+	}
+}
+
+/**
+ * @brief Class Rotation: a respawn with the previous class switches to the next class the team limits allow.
+ * The class is kept when every other class is full.
+ * @return qtrue when the session loadout was changed and userinfo needs an update.
+ */
+qboolean G_ETLabRotateClass(gentity_t *ent)
+{
+	gclient_t *client = ent->client;
+	qboolean  changed = qfalse;
+
+	if (client->sess.sessionTeam != TEAM_AXIS && client->sess.sessionTeam != TEAM_ALLIES)
+	{
+		return qfalse;
+	}
+	if (G_ETLabModifierActive(ETLAB_MOD_CLASSROTATION) && client->pers.etlabLastSpawnClass &&
+	    client->sess.playerType == client->pers.etlabLastSpawnClass - 1)
+	{
+		bg_playerclass_t *classInfo;
+		int              next = client->sess.playerType, i;
+
+		for (i = 1; i < NUM_PLAYER_CLASSES; i++)
+		{
+			next = (client->sess.playerType + i) % NUM_PLAYER_CLASSES;
+			if (!G_IsClassFull(ent, next, client->sess.sessionTeam))
+			{
+				break;
+			}
+		}
+
+		if (i < NUM_PLAYER_CLASSES)
+		{
+			client->sess.playerType = client->sess.latchPlayerType = next;
+			classInfo               = BG_GetPlayerClassInfo(client->sess.sessionTeam, next);
+			client->sess.playerWeapon = client->sess.latchPlayerWeapon = classInfo->classPrimaryWeapons[0].weapon;
+			client->sess.playerWeapon2 = client->sess.latchPlayerWeapon2 = classInfo->classSecondaryWeapons[0].weapon;
+			trap_SendServerCommand(client->ps.clientNum, va("cp \"^3Class Rotation: ^7you spawn as ^5%s^7 this time.\" 1", BG_ClassnameForNumber(next)));
+			changed = qtrue;
+		}
+	}
+	client->pers.etlabLastSpawnClass = client->sess.playerType + 1;
+	return changed;
+}
+
+/**
+ * @brief Vampire: an enemy kill restores health to the attacker.
+ */
+void G_ETLabModifierOnKill(gentity_t *victim, gentity_t *attacker)
+{
+	if (!G_ETLabModifierActive(ETLAB_MOD_VAMPIRE) || !attacker || !attacker->client || attacker == victim ||
+	    attacker->health <= 0 || OnSameTeam(victim, attacker))
+	{
+		return;
+	}
+	attacker->health = MIN(attacker->health + ETLAB_VAMPIRE_HEAL, attacker->client->ps.stats[STAT_MAX_HEALTH]);
+	attacker->client->ps.stats[STAT_HEALTH] = attacker->health;
+}
+
+static void G_ETLabModifierList(gentity_t *ent)
+{
+	int i;
+
+	G_refPrintf(ent, "\nAvailable round modifiers (g_etlabModifierPool):\n------------------------------");
+	for (i = ETLAB_MOD_NONE + 1; i < ETLAB_MOD_COUNT; i++)
+	{
+		if (BG_ETLabModifierInPool(g_etlabModifierPool.string, i))
+		{
+			G_refPrintf(ent, "  %-14s ^3%s^7 - %s%s", etlabModifiers[i].name, etlabModifiers[i].title,
+			            etlabModifiers[i].description, etlabModifiers[i].gaudi ? " (timed)" : "");
+		}
+	}
+	G_refPrintf(ent, "  %-14s ^3%s", "none", "Regular rules");
+}
+
+/**
+ * @brief callvote modifier <name|none>
+ */
+int G_ETLabModifier_v(gentity_t *ent, unsigned int dwVoteIndex, char *arg, char *arg2, qboolean fRefereeCmd)
+{
+	// Vote request (vote is being initiated)
+	if (arg)
+	{
+		int      index;
+		qboolean referee = ent && ent->client && ent->client->sess.referee;
+
+		if (g_etlabModifierMode.integer != ETLAB_MODE_VOTE && g_etlabModifierMode.integer != ETLAB_MODE_RANDOM_VOTE && !referee)
+		{
+			G_refPrintf(ent, "^3Round modifier votes are not enabled on this server (g_etlabModifierMode %i).", g_etlabModifierMode.integer);
+			G_voteCurrentSetting(ent, arg, G_ETLabModifierName(level.etlabModifier));
+			return G_INVALID;
+		}
+		else if (G_voteDescription(ent, fRefereeCmd, dwVoteIndex))
+		{
+			G_ETLabModifierList(ent);
+			G_voteCurrentSetting(ent, arg, G_ETLabModifierName(level.etlabModifier));
+			return G_INVALID;
+		}
+
+		index = BG_ETLabModifierByName(arg2);
+		if (index < 0 || (index != ETLAB_MOD_NONE && !BG_ETLabModifierInPool(g_etlabModifierPool.string, index)))
+		{
+			G_refPrintf(ent, "\n^3Unknown or unavailable round modifier: ^7%s", arg2);
+			G_ETLabModifierList(ent);
+			return G_INVALID;
+		}
+		if (index == level.etlabModifier)
+		{
+			G_refPrintf(ent, "\n^3Round modifier^5 is already %s!", G_ETLabModifierName(index));
+			return G_INVALID;
+		}
+
+		Com_sprintf(level.voteInfo.vote_value, VOTE_MAXSTRING, "%s", G_ETLabModifierName(index));
+		Com_sprintf(arg2, VOTE_MAXSTRING, "%s", index == ETLAB_MOD_NONE ? "none" : etlabModifiers[index].title);
+
+		// Vote action (vote has passed)
+	}
+	else
+	{
+		int index = BG_ETLabModifierByName(level.voteInfo.vote_value);
+
+		G_ETLabModifierSet(index < 0 ? ETLAB_MOD_NONE : index, qtrue);
+	}
+
+	return G_OK;
+}
