+/* ETLab: a revealed flag can be shot without blocking player movement. */
+void G_RevealLandmine(gentity_t *mine)
+{
+	mine->s.modelindex2 = 1;
+	mine->takedamage = qtrue;
+	mine->r.snapshotCallback = qfalse;
+	mine->s.frame = rand() % 20;
+	mine->r.contents = CONTENTS_CORPSE;
+	VectorSet(mine->r.mins, -12, -12, 0);
+	VectorSet(mine->r.maxs, 12, 12, 40);
+	trap_LinkEntity(mine);
+}
